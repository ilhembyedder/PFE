# LeasRecover — environment configuration
# Copy to .env and adjust. Never commit the result.

# ==========================================
# Database
# ==========================================
DB_NAME=leasrecover
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# ==========================================
# Backend
# ==========================================
BACKEND_PORT=8080

# REQUIRED. The application must refuse to start without a real value.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Where uploaded documents are written. Must be a mounted volume in Docker,
# otherwise every document is lost when the container is recreated.
UPLOAD_DIR=/app/uploads

# Outbound mail. There is no safe default; leave blank to disable.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Tenant resolution must come from the authenticated principal, never from
# client-supplied X-Tenant-ID / X-User-Email headers.
APP_SECURITY_ALLOW_HEADER_FALLBACK=false

# Daily alert engine sweep (Spring cron, 6 fields).
APP_ALERTS_CRON=0 0 2 * * *

# ==========================================
# Frontend
# ==========================================
FRONTEND_PORT=3000

# REQUIRED. Where the BFF route handlers reach the Spring API, server-side.
# No /api/v1 suffix: the code appends it.
BACKEND_URL=http://localhost:8080

# REQUIRED, minimum 32 characters. Seals the session cookie with AES-256-GCM
# so the backend JWT never reaches the browser. There is no fallback: the
# frontend throws without it, in every environment.
# Generate one with:  openssl rand -base64 32
BFF_COOKIE_SECRET=

# Idle timeout before automatic logout, milliseconds. Default 15 minutes.
NEXT_PUBLIC_IDLE_TIMEOUT=900000

# ==========================================
# AI service
# ==========================================
AI_SERVICE_PORT=8000

# Backend -> AI service, and the webhook the AI service calls back on.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_WEBHOOK_URL=http://backend:8080/api/v1/internal/webhooks/ai-progress

# NOTE: extraction is currently simulated and returns a fixed result for
# every upload, so no model provider is contacted. See docs/CODE_REVIEW.md C7.
# These are placeholders for when it is implemented.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
